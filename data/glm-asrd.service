[Unit]
Description=GLM ASR Daemon for Voice Typing
After=pipewire.service pipewire-pulse.service graphical-session.target
Requires=pipewire.service
Wants=graphical-session.target

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do [ -e "$XDG_RUNTIME_DIR/wayland-0" ] && exit 0; sleep 1; done; exit 1'
ExecStart=/usr/bin/glm-asrd
Restart=on-failure
RestartSec=3
Environment=RUST_LOG=info

[Install]
WantedBy=default.target
